# SalesFinder environment. Copy to .env (git-ignored) and fill in.
# Every variable maps to a Settings field; defaults shown are used when unset.

# REQUIRED. Postgres connection URL (asyncpg driver).
SALESFINDER_DATABASE_URL=postgresql+asyncpg://localhost/salesfinder

# REQUIRED. Secret key for signing, at least 32 characters. Startup fails if empty. Generate with:
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
SALESFINDER_SECRET_KEY=

# Interface to bind. Default 127.0.0.1 (loopback only).
# Any non-loopback value (LAN mode) REQUIRES both TLS variables below, or startup refuses.
# SALESFINDER_BIND_HOST=127.0.0.1

# Port to listen on. Default 5555.
# SALESFINDER_PORT=5555

# TLS certificate and key (PEM paths). Default unset. Required together for LAN mode.
# SALESFINDER_TLS_CERTFILE=/path/to/cert.pem
# SALESFINDER_TLS_KEYFILE=/path/to/key.pem

# Accepted Host headers, as a JSON list. Default ["127.0.0.1","localhost"].
# In LAN mode add the names teammates' browsers use, e.g.
#   ["salesfinder.local","192.168.1.20","127.0.0.1","localhost"]
# Never "*" (it turns off the DNS-rebinding protection).
# SALESFINDER_ALLOWED_HOSTS=["127.0.0.1","localhost"]

# The address teammates open, scheme://host[:port] with no path, used for invite links (so a link
# made while browsing on localhost still works for a teammate). Must be https in LAN mode, and
# its host must be in SALESFINDER_ALLOWED_HOSTS. Default unset (links use the address the admin
# browsed from).
# SALESFINDER_PUBLIC_URL=https://salesfinder.local:5555

# Directory holding salesfinder.yaml / salesfinder.local.yaml. Default config.
# SALESFINDER_CONFIG_DIR=config

# Log level. Default INFO.
# SALESFINDER_LOG_LEVEL=INFO

# JSON-formatted logs (true/false). Default false.
# SALESFINDER_LOG_JSON=false

# Write logs to this file instead of stderr (reopened after newsyslog rotates it). Default unset.
# The launchd plists set it (~/Library/Logs/SalesFinder/web.log / worker.log); leave it unset here.
# SALESFINDER_LOG_FILE=

# Login session lifetime in hours. Default 12.
# SALESFINDER_SESSION_TTL_HOURS=12

# Claude CLI executable (name on PATH or absolute path). Default claude.
# SALESFINDER_CLAUDE_BIN=claude

# HubSpot private-app token (read-only access: companies, contacts). Default unset.
# SALESFINDER_HUBSPOT_TOKEN=

# Serper.dev API key for discovery searches. Default unset.
# SALESFINDER_SERPER_API_KEY=


# Optional email verifier API key (MillionVerifier), used only when contacts.verifier is set to
# millionverifier in config. Never called for addresses published on the company's own pages.
# Default unset.
# SALESFINDER_EMAIL_VERIFIER_KEY=

# Mailbox app passwords (Gmail/Workspace), as a JSON object keyed by each mailbox's secret name:
#   {"sales": "abcd efgh ijkl mnop"}
# Only the secret name is stored in the database. Default unset (no mailbox can send).
# Set it in one place: an exported shell value replaces this one as a whole (never merged).
# SALESFINDER_MAILBOX_PASSWORDS={}
